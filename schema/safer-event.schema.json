{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SAFER Event Payload v1.1",
  "type": "object",
  "required": [
    "CUSTOMER",
    "PANEL_ID",
    "DEVICE_ID",
    "DEVICE_TYPE",
    "DEVICE_LOCATION",
    "STATUS",
    "SAFER_ID"
  ],
  "properties": {
    "CUSTOMER": {
      "type": "string"
    },
    "PANEL_ID": {
      "type": "string"
    },
    "DEVICE_ID": {
      "type": "string"
    },
    "DEVICE_TYPE": {
      "type": "string"
    },
    "DEVICE_LOCATION": {
      "type": "string"
    },
    "STATUS": {
      "type": "integer",
      "enum": [
        1,
        2,
        3,
        4,
        5,
        6
      ]
    },
    "SAFER_ID": {
      "type": "object",
      "required": [
        "version",
        "unique_id"
      ],
      "properties": {
        "version": {
          "type": "string",
          "const": "1.1"
        },
        "unique_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "OPTIONAL": {
      "type": "object"
    }
  },
  "additionalProperties": true,
  "$id": "https://raw.githubusercontent.com/rescuelogic/SAFER/main/schema/safer-event.schema.json"
}
